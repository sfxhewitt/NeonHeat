{
  "$schema": "./mission.schema.json",
  "id": "glasshounds_03_hot_chrome",
  "faction": "glasshounds",
  "title": "Hot Chrome",
  "summary": "Kurogane left a prototype in a car park. Unguarded, apparently.",
  "chain": 3,
  "giver": { "type": "payphone", "at": "marker:ashgrove_payphone_1" },
  "prerequisites": { "missions": ["glasshounds_02_test_drive"] },
  "budgetMinutes": 6,
  "spawns": {
    "prototype_car": { "variant": "prototype", "at": "marker:glass_lot_2", "yaw": -1.5708, "locked": true, "role": "target" }
  },
  "objectives": [
    { "id": "goto_lot", "type": "reach", "target": "marker:glass_lot_2", "radius": 6,
      "onStart": [{ "do": "dialogue", "line": "gh_03_intro" }] },
    { "id": "hack_car", "type": "hack", "target": "spawn:prototype_car",
      "minigame": "sequence", "difficulty": 2,
      "onFail": [{ "do": "addTrace", "value": 40 }] },
    { "id": "deliver", "type": "deliverVehicle", "vehicle": "spawn:prototype_car",
      "target": "marker:chopshop_1", "minHealth": 0.5, "timeLimitSec": 180,
      "onStart": [{ "do": "setHeat", "value": 2 },
                  { "do": "dialogue", "line": "gh_03_alarm" },
                  { "do": "spawnSquad", "squad": "kurogane_pursuit", "delaySec": 20 }],
      "onComplete": [{ "do": "dialogue", "line": "gh_03_done" }] }
  ],
  "rewards": { "credits": 1500, "rep": { "glasshounds": 10, "kurogane": -15 } },
  "failPolicy": "checkpoint"
}
