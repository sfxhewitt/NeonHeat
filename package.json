{
  "name": "neonheat",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @neonheat/game dev",
    "build": "pnpm --filter @neonheat/game build",
    "preview": "pnpm --filter @neonheat/game preview",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test -c playwright.config.ts",
    "playtest": "playwright test -c playwright.config.ts --project=playtest",
    "perf": "playwright test -c playwright.perf.config.ts",
    "soak": "SOAK_MINUTES=20 playwright test -c playwright.perf.config.ts tests/perf/soak.spec.ts",
    "mission-lint": "tsx tools/mission-lint/src/cli.ts",
    "size": "node tools/size-check.mjs",
    "overnight:check": "node tools/overnight/check.mjs",
    "overnight:backlog": "node tools/overnight/backlog.mjs",
    "overnight:guard": "node tools/overnight/guard.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@neonheat/audio": "workspace:*",
    "@neonheat/content": "workspace:*",
    "@neonheat/engine": "workspace:*",
    "@neonheat/missions": "workspace:*",
    "@neonheat/save": "workspace:*",
    "@neonheat/sim": "workspace:*",
    "@neonheat/ui": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
